{
  "name": "tire-rig-dashboard",
  "version": "1.0.0",
  "description": "Real-time tire simulation telemetry dashboard",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "three": "^0.167.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
