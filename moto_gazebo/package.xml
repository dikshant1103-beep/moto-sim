<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moto_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo sensor-world for moto_sim (A3): a city/road world plus a kinematic
    camera+lidar bike posed by Chrono telemetry. Chrono does physics; Gazebo renders
    sensors and publishes ROS 2 topics for SLAM and multi-vehicle.</description>
  <maintainer email="261631710+dikshant1103-beep@users.noreply.github.com">dikshant</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>moto_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
